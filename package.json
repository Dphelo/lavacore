{
  "name": "lavacore",
  "version": "0.1.0",
  "description": "A modern Windows productivity, system monitoring, weather, faith and performance companion.",
  "main": "nova.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "LavaCore contributors; based on Nova Island by AmerTech",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.dphelo.lavacore",
    "productName": "LavaCore",
    "copyright": "Copyright © 2026 LavaCore contributors. Based on Nova Island by AmerTech.",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "!promo/**",
      "!dist/**",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd",
      "!.*/**",
      "!NEXT-RELEASE.md",
      "!contrib/**",
      "!keys/**",
      "!lavacore-plugins/**",
      "!tools/**",
      "!scripts/**",
      "!news.json",
      "!build/appx/**",
      "!store/**"
    ],
    "asarUnpack": [
      "helper/nova-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "LavaCore"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "LavaCore-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LavaCore",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "LavaCore-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}
